{
  "name": "obsidian-html-works",
  "version": "0.1.0",
  "description": "View HTML files and edit their source in the native editor.",
  "author": "zarnuq",
  "license": "GPL-3.0",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:live": "node scripts/check-live.mjs",
    "install:plugin": "npm run build && node scripts/install.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^30.1.2",
    "obsidian": "^1.6.6",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
